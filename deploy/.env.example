# deploy/.env şablonu — `cp .env.example .env` ve doldurun. deploy/.env repoya GİRMEZ.
# Tüm uygulama ayarlarının açıklaması: backend/.env.example.
# (Değerle aynı satıra yorum yazmayın.)

# --- Caddy ---
# API adresi api.$DOMAIN olur. Yerel test: localhost (→ https://api.localhost, Caddy yerel CA).
DOMAIN=localhost

# --- Sırlar ---
APP_SECRET=
APP_PASSWORD=
ADMIN_USERNAME=
ANTHROPIC_API_KEY=
FINNHUB_API_KEY=
NEWSAPI_KEY=
FMP_API_KEY=

# --- AWS profili: frontend newsradarapp.com (CloudFront), API api.newsradarapp.com ---
NEWSRADAR_CORS_ORIGINS=https://newsradarapp.com,https://www.newsradarapp.com
# Frontend ve API aynı site → Lax yeter; cookie tüm alt alan adlarında geçerli.
NEWSRADAR_COOKIE_SAMESITE=lax
NEWSRADAR_COOKIE_SECURE=on
NEWSRADAR_COOKIE_DOMAIN=.newsradarapp.com
NEWSRADAR_HOSTING_PROVIDER=AWS
NEWSRADAR_CONTACT_EMAIL=

# --- Uygulama ---
NEWSRADAR_LLM_PROVIDER=anthropic
NEWSRADAR_SCHEDULER=on
NEWSRADAR_SEED_ON_START=on
# NEWSRADAR_DB, NEWSRADAR_TRUSTED_PROXY=caddy ve NEWSRADAR_CADDY_IP docker-compose.yml'de sabit.
