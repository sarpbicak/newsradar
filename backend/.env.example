# NewsRadar — ortam değişkenleri. Bu dosyayı `.env` olarak kopyalayın.
# Anahtarlar koda gömülmez; hepsi buradan okunur.

# Uygulama giriş şifresi (paylaşılan tek parola). Boş bırakırsanız giriş devre
# dışı olur ve korumalı uçlar 503 döner — yani mutlaka bir değer verin.
APP_PASSWORD=

# Katman 2 — kişisel hesaplar. Bu kullanıcı adıyla kayıt olan admin (kullanım paneli)
# olur. Boş bırakırsanız: İLK kayıt olan kullanıcı otomatik admin olur.
ADMIN_USERNAME=

# Oturum token'ı imza sırrı (ayrı ve GÜÇLÜ olmalı; yoksa APP_PASSWORD'a düşer).
# Üret: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=
# Token geçerlilik süresi (gün) ve en fazla kayıtlı kullanıcı (0 = sınırsız).
NEWSRADAR_TOKEN_TTL_DAYS=30
NEWSRADAR_MAX_USERS=10
# Kişi başı kotalar (admin muaf; 0 = sınırsız). İzleme listesi üst sınırı ve
# 24 saatte elle yenileme hakkı.
NEWSRADAR_MAX_ENTITIES_PER_USER=15
NEWSRADAR_MAX_REFRESH_PER_DAY=5

# --- LLM analiz motoru (GERİ DÖNÜLEBİLİR + OpenAI-uyumlu herhangi bir endpoint) ---
# anthropic → Claude; başka her değer → OpenAI-uyumlu endpoint (OpenRouter/NVIDIA/…).
# Sorun çıkarsa NEWSRADAR_LLM_PROVIDER=anthropic yeter.
NEWSRADAR_LLM_PROVIDER=openrouter
# OpenAI-uyumlu endpoint. OpenRouter: https://openrouter.ai/api/v1 (model meta-llama/...)
#   NVIDIA:  https://integrate.api.nvidia.com/v1 (model meta/llama-3.3-70b-instruct)
NEWSRADAR_LLM_BASE_URL=https://openrouter.ai/api/v1
NEWSRADAR_LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# OpenAI-uyumlu endpoint anahtarı (OpenRouter/NVIDIA/… — hangisini kullanıyorsan).
NEWSRADAR_LLM_API_KEY=

# Claude (NEWSRADAR_LLM_PROVIDER=anthropic iken kullanılır). https://console.anthropic.com
# GERİ DÖNÜŞ için env'de bırakın. Model adı: NEWSRADAR_MODEL (aşağıda).
ANTHROPIC_API_KEY=sk-ant-...

# Finnhub — public ticker haberleri (/company-news). https://finnhub.io
# Eksikse ticker sağlayıcısı atlanır (UI'da uyarı gösterilir), uygulama çökmez.
FINNHUB_API_KEY=

# NewsAPI — startup/keyword haberleri (/v2/everything). https://newsapi.org
# Ücretsiz katman ~24s gecikmeli — v1 için kabul edilebilir.
# Eksikse keyword sağlayıcısı atlanır.
NEWSAPI_KEY=

# FMP (Financial Modeling Prep) — GERÇEK analist HEDEF FİYATI. https://financialmodelingprep.com
# Finnhub ücretsiz katmanda hedef fiyat vermiyor (403 premium); FMP ücretsiz katmanı
# price-target-consensus ile sağlar. Eksik/erişilemezse hedef fiyat gösterilmez
# (tavsiye ve haber akışı etkilenmez). Ücretsiz katmanı doğrulamak için:
#   python -m app.cli fmp-check AMD
FMP_API_KEY=

# Opsiyonel ayarlar
# Not: Değerlerle aynı satıra yorum yazmayın; python-dotenv onları değere dahil eder.

# SQLite dosya yolu
NEWSRADAR_DB=newsradar.db
# Her yenilemede kaç saatlik haber çekilsin (ilk taramayı kısaltmak için 24 deneyin)
NEWSRADAR_LOOKBACK_HOURS=48
# Kullanılacak Claude modeli. Geçersiz bir ad API'de sessiz boş/404 yanıta yol
# açabilir — yalnızca geçerli bir model verin.
NEWSRADAR_MODEL=claude-sonnet-4-6
# Otomatik yenileme: on | off
NEWSRADAR_SCHEDULER=on
# Otomatik yenileme aralığı (saat). Saatlik agresiftir; NewsAPI kotası için 6 önerilir
NEWSRADAR_SCHEDULER_HOURS=6
# NewsAPI günlük istek sınırı (ücretsiz katman ~100). Kota dolunca keyword çekme atlanır
NEWSAPI_DAILY_LIMIT=100

# --- Analiz performans/maliyet (hepsi opsiyonel; kod değişikliği gerekmez) ---
# Tek Claude çağrısında kaç makale analiz edilsin. DİKKAT: büyük batch + geniş çıktı
# şeması max_output_tokens'ı aşarsa yanıt kesilir (stop_reason=max_tokens) → hata.
NEWSRADAR_BATCH_SIZE=10
# Makale-batch çağrısı için üretim (output) token tavanı. Yanıt kesilirse artırın.
NEWSRADAR_MAX_OUTPUT_TOKENS=8192
# Tek yenilemede entity başına en fazla kaç makale (en yeniler öncelikli)
NEWSRADAR_MAX_ARTICLES_PER_ENTITY=25
# Aynı anda kaç Claude çağrısı çalışsın (paralellik; rate limit'e göre ayarlayın)
NEWSRADAR_ANALYSIS_CONCURRENCY=5
