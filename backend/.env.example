# NewsRadar — ortam değişkenleri. Bu dosyayı `.env` olarak kopyalayın.
# Anahtarlar koda gömülmez; hepsi buradan okunur.

# Uygulama giriş şifresi (paylaşılan tek parola). Boş bırakırsanız giriş devre
# dışı olur ve korumalı uçlar 503 döner — yani mutlaka bir değer verin.
APP_PASSWORD=

# Claude (haber analizi için ZORUNLU). https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Finnhub — public ticker haberleri (/company-news). https://finnhub.io
# Eksikse ticker sağlayıcısı atlanır (UI'da uyarı gösterilir), uygulama çökmez.
FINNHUB_API_KEY=

# NewsAPI — startup/keyword haberleri (/v2/everything). https://newsapi.org
# Ücretsiz katman ~24s gecikmeli — v1 için kabul edilebilir.
# Eksikse keyword sağlayıcısı atlanır.
NEWSAPI_KEY=

# Opsiyonel ayarlar
# Not: Değerlerle aynı satıra yorum yazmayın; python-dotenv onları değere dahil eder.

# SQLite dosya yolu
NEWSRADAR_DB=newsradar.db
# Her yenilemede kaç saatlik haber çekilsin
NEWSRADAR_LOOKBACK_HOURS=48
# Kullanılacak Claude modeli
NEWSRADAR_MODEL=claude-sonnet-4-6
# Saatlik otomatik yenileme: on | off
NEWSRADAR_SCHEDULER=on
