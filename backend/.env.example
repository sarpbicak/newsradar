# NewsRadar — ortam değişkenleri. Bu dosyayı `.env` olarak kopyalayın.
# Anahtarlar koda gömülmez; hepsi buradan okunur.

# Uygulama giriş şifresi (paylaşılan tek parola). Boş bırakırsanız giriş devre
# dışı olur ve korumalı uçlar 503 döner — yani mutlaka bir değer verin.
APP_PASSWORD=

# Claude (haber analizi için ZORUNLU). https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Finnhub — public ticker haberleri (/company-news). https://finnhub.io
# Eksikse ticker sağlayıcısı atlanır (UI'da uyarı gösterilir), uygulama çökmez.
FINNHUB_API_KEY=

# NewsAPI — startup/keyword haberleri (/v2/everything). https://newsapi.org
# Ücretsiz katman ~24s gecikmeli — v1 için kabul edilebilir.
# Eksikse keyword sağlayıcısı atlanır.
NEWSAPI_KEY=

# Opsiyonel ayarlar
# Not: Değerlerle aynı satıra yorum yazmayın; python-dotenv onları değere dahil eder.

# SQLite dosya yolu
NEWSRADAR_DB=newsradar.db
# Her yenilemede kaç saatlik haber çekilsin (ilk taramayı kısaltmak için 24 deneyin)
NEWSRADAR_LOOKBACK_HOURS=48
# Kullanılacak Claude modeli. Geçersiz bir ad API'de sessiz boş/404 yanıta yol
# açabilir — yalnızca geçerli bir model verin.
NEWSRADAR_MODEL=claude-sonnet-4-6
# Otomatik yenileme: on | off
NEWSRADAR_SCHEDULER=on
# Otomatik yenileme aralığı (saat). Saatlik agresiftir; NewsAPI kotası için 6 önerilir
NEWSRADAR_SCHEDULER_HOURS=6
# NewsAPI günlük istek sınırı (ücretsiz katman ~100). Kota dolunca keyword çekme atlanır
NEWSAPI_DAILY_LIMIT=100

# --- Analiz performans/maliyet (hepsi opsiyonel; kod değişikliği gerekmez) ---
# Tek Claude çağrısında kaç makale analiz edilsin. DİKKAT: büyük batch + geniş çıktı
# şeması max_output_tokens'ı aşarsa yanıt kesilir (stop_reason=max_tokens) → hata.
NEWSRADAR_BATCH_SIZE=10
# Makale-batch çağrısı için üretim (output) token tavanı. Yanıt kesilirse artırın.
NEWSRADAR_MAX_OUTPUT_TOKENS=8192
# Tek yenilemede entity başına en fazla kaç makale (en yeniler öncelikli)
NEWSRADAR_MAX_ARTICLES_PER_ENTITY=25
# Aynı anda kaç Claude çağrısı çalışsın (paralellik; rate limit'e göre ayarlayın)
NEWSRADAR_ANALYSIS_CONCURRENCY=5
